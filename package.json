{
    "name": "branch-locator",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "data:build": "tsx scripts/build-branches.ts scripts/data/overture-capitec.json",
        "data:test": "vitest run scripts",
        "e2e": "playwright test",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"*.{ts,js}\"",
        "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"*.{ts,js}\""
    },
    "private": true,
    "packageManager": "npm@11.20.0",
    "dependencies": {
        "@angular/common": "^22.3.0",
        "@angular/compiler": "^22.3.0",
        "@angular/core": "^22.3.0",
        "@angular/forms": "^22.3.0",
        "@angular/platform-browser": "^22.3.0",
        "@angular/service-worker": "^22.3.0",
        "@fontsource/poppins": "^5.3.0",
        "leaflet": "^1.9.4",
        "leaflet.markercluster": "^1.5.3",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.3.0",
        "@angular/cli": "^22.3.0",
        "@angular/compiler-cli": "^22.3.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.1",
        "@types/leaflet": "^1.9.22",
        "@types/leaflet.markercluster": "^1.5.6",
        "@types/node": "^22.0.0",
        "angular-eslint": "^22.8.0",
        "eslint": "^10.15.0",
        "jsdom": "^31.0.0",
        "prettier": "^3.8.1",
        "tsx": "^4.19.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.74.0",
        "vitest": "^5.0.0"
    }
}
